# Example environment variables (do NOT commit real secrets)
# Copy to .env.local and fill in with real values for local development.

# OpenAI API key (optional — if set, app will call OpenAI for Scribe/Advisor)
OPENAI_API_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Managed Postgres connection (Neon/Supabase/Vercel Postgres)
# Example format:
# postgres://db_user:db_password@db-host.example.com:5432/db_name
DATABASE_URL=postgres://username:password@host:5432/database

# Optional DB SSL tuning
# set to 'require' in most managed providers
DATABASE_SSL_MODE=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Worker Cron authentication
# On Vercel, CRON_SECRET is set automatically and sent as 'Authorization: Bearer <secret>'
# on every cron invocation. Set WORKER_CRON_SECRET for local dev / self-hosted runners.
# If neither is set the /api/worker endpoint is unauthenticated (development only).
WORKER_CRON_SECRET=replace-with-a-long-random-secret
